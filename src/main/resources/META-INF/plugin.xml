<idea-plugin>
    <id>com.github.plaskowski.embeddedbrowserintellijplugin</id>
    <name>EmbeddedBrowser</name>
    <vendor>plaskowski</vendor>

    <!-- Product and plugin compatibility requirements -->
    <!-- https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.plaskowski.embeddedbrowserintellijplugin.EmbeddedBrowserAppSettings"/>
        <applicationConfigurable
            instance="com.github.plaskowski.embeddedbrowserintellijplugin.ui.EmbeddedBrowserConfigurable"
            displayName="Embedded Browser"
            parentId="tools"/>
        <projectService serviceImplementation="com.github.plaskowski.embeddedbrowserintellijplugin.EmbeddedBrowserSettings"/>
        <notificationGroup id="EmbeddedBrowser" displayType="BALLOON" isLogByDefault="false"/>
        <toolWindow id="Embedded Browser" anchor="right"
            icon="/META-INF/pluginIcon.svg"
            factoryClass="com.github.plaskowski.embeddedbrowserintellijplugin.ui.EmbeddedBrowserToolWindowFactory"/>
    </extensions>

</idea-plugin>
